{
  "name": "@anan/proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --external:hono --external:@hono/node-server --external:@google/generative-ai --external:zod",
    "start": "node dist/server.js",
    "test": "vitest run",
    "scripted-run": "tsx scripts/scripted-run.ts",
    "journal-eval": "tsx scripts/journal-eval.ts",
    "sync-rollback": "tsx scripts/sync-rollback.ts",
    "journal-cloze-eval": "tsx scripts/journal-cloze-eval.ts",
    "stories-eval": "tsx scripts/stories-eval.ts",
    "smoke": "tsx scripts/smoke-proxy.ts"
  },
  "dependencies": {
    "@anan/core": "workspace:*",
    "@google/generative-ai": "^0.21.0",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
