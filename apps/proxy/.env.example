# Copy to apps/proxy/.env (gitignored). The server loads that file at startup;
# real environment variables (e.g. a PM2 env_production block) take precedence.
# Never commit a real .env.

# At least one of these two must be set or every /v1/turn request fails.
# Both set = Gemini primary, OpenAI fallback (CLAUDE.md default).
GEMINI_API_KEY=
OPENAI_API_KEY=
# OpenAI is never called unless this is 1 (it is not free).
OPENAI_ENABLED=0

# Model names per task come from env config, not code.
GEMINI_MODEL_TURN=gemini-3.5-flash-lite
OPENAI_MODEL_TURN=gpt-4o-mini
# Journal review / alternative-fix check / explain-more (Phase 5)
GEMINI_MODEL_JOURNAL=gemini-3.5-flash-lite
OPENAI_MODEL_JOURNAL=gpt-4o-mini

# Locked down to the actual deployed web origin in production —
# https://holop.dev in this project's deployment (see README.md).
CORS_ORIGIN=http://localhost:5183

# Per-install-id (X-Install-Id header) limits.
RATE_LIMIT_PER_MINUTE=20
DAILY_TOKEN_BUDGET=200000

PORT=3002

# Which data/prompts/tutor-system.<version>.md to load.
PROMPT_VERSION=v1

# Phase 8: the household code. REQUIRED — the server refuses to start without
# it. Every sync and AI request must send it (header X-Site-Code); the web app
# asks for it once per browser. Change it here to make every browser ask again.
SITE_CODE=tofu
# Where each profile's saved copy (last 10 versions) is written. Default: apps/proxy/sync-data
# SYNC_DIR=/home/an-an/sync-data

# Phase 10: where audio OK / "sounds wrong" marks are written. Default: apps/proxy/audio-data
# AUDIO_DIR=/home/an-an/audio-data
# NOTE: no Azure key belongs here — audio is built offline (docs/audio.md).

# Phase 12: where the private textbook text lives (<dir>/laixue-1/private/dialogues.json …).
# Default: the repo's data/curriculum. Copy private/ to the server by hand — it is not in git.
# TEXTBOOK_DIR=/home/an-an/curriculum
