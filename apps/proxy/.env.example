# Copy to apps/proxy/.env (gitignored). The server loads that file at startup;
# real environment variables (e.g. a PM2 env_production block) take precedence.
# Never commit a real .env.

# REQUIRED: the server refuses to start without it. Gemini (free tier) is the only AI provider.
GEMINI_API_KEY=

# Phase 33: the free tier counts requests per model per day, so each role has a CHAIN of models
# (comma list, tried in order; a model out of free quota is skipped with no call). Defaults:
# GEMINI_CHAIN_TURN=gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash
# GEMINI_CHAIN_JOURNAL=gemini-3.5-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
# GEMINI_CHAIN_STORY=gemini-2.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# GEMINI_CHAIN_CHECK=gemini-2.5-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash
# Added as the last link of every chain (when not already in it):
# GEMINI_MODEL_FALLBACK=
# The old one-model settings (GEMINI_MODEL_TURN/JOURNAL/STORY/CHECK) are no longer read by the
# proxy; delete them.

# Known daily request limits (see https://ai.dev/rate-limit). A limit in a 429 is learned too.
# GEMINI_DAILY_LIMITS=gemini-2.5-flash=20
# Batch scripts (x-ai-priority: batch) leave this share of a known limit for the live app, and at
# least this many calls:
# GEMINI_BATCH_RESERVE_SHARE=0.3
# GEMINI_BATCH_RESERVE_MIN=5
# The quota tracker's state (shared with the scripts and `pnpm ai:quota`). Default: apps/proxy/quota-data/quota.json
# QUOTA_FILE=/home/an-an/quota-data/quota.json

# Locked down to the actual deployed web origin in production —
# https://holop.dev in this project's deployment (see README.md).
CORS_ORIGIN=http://localhost:5183

# Per-install-id (X-Install-Id header) limits.
RATE_LIMIT_PER_MINUTE=20
DAILY_TOKEN_BUDGET=200000

PORT=3002

# Which data/prompts/tutor-system.<version>.md to load.
PROMPT_VERSION=v1

# Phase 8: the household code. REQUIRED — the server refuses to start without
# it. Every sync and AI request must send it (header X-Site-Code); the web app
# asks for it once per browser. Change it here to make every browser ask again.
SITE_CODE=tofu
# Where each profile's saved copy (last 10 versions) is written. Default: apps/proxy/sync-data
# SYNC_DIR=/home/an-an/sync-data

# Phase 10: where audio OK / "sounds wrong" marks are written. Default: apps/proxy/audio-data
# AUDIO_DIR=/home/an-an/audio-data
# NOTE: no Azure key belongs here — audio is built offline (docs/audio.md).

# Phase 12: where the private textbook text lives (<dir>/laixue-1/private/dialogues.json …).
# Default: the repo's data/curriculum. Copy private/ to the server by hand — it is not in git.
# TEXTBOOK_DIR=/home/an-an/curriculum
