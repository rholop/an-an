# Copy to apps/proxy/.env (gitignored). The server loads that file at startup;
# real environment variables (e.g. a PM2 env_production block) take precedence.
# Never commit a real .env.

# At least one of these two must be set or every /v1/turn request fails.
# Both set = Gemini primary, OpenAI fallback (CLAUDE.md default).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model names per task come from env config, not code.
GEMINI_MODEL_TURN=gemini-1.5-flash
OPENAI_MODEL_TURN=gpt-4o-mini

# Locked down to the actual deployed web origin in production —
# https://holop.dev in this project's deployment (see README.md).
CORS_ORIGIN=http://localhost:5183

# Per-install-id (X-Install-Id header) limits.
RATE_LIMIT_PER_MINUTE=20
DAILY_TOKEN_BUDGET=200000

PORT=3002

# Which data/prompts/tutor-system.<version>.md to load.
PROMPT_VERSION=v1
