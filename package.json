{
  "name": "anan",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pipeline:build": "pnpm --filter @anan/data-pipeline build:lexicon && pnpm --filter @anan/data-pipeline build:scenarios",
    "curriculum:import": "pnpm --filter @anan/data-pipeline curriculum:import",
    "check:azure-key": "node scripts/check-no-azure-key.mjs",
    "dev:web": "pnpm --filter @anan/web dev",
    "curriculum:build": "pnpm --filter @anan/data-pipeline curriculum:build",
    "curriculum:plan": "pnpm --filter @anan/data-pipeline curriculum:plan",
    "curriculum:content": "pnpm --filter @anan/data-pipeline curriculum:content",
    "audit:curriculum": "pnpm --filter @anan/data-pipeline audit:curriculum",
    "stories:build": "pnpm --filter @anan/data-pipeline stories:build",
    "eval:journal": "pnpm --filter @anan/proxy journal-cloze-eval",
    "eval:stories": "pnpm --filter @anan/proxy stories-eval",
    "smoke:proxy": "pnpm --filter @anan/proxy smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "eslint": "^9.13.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
