node_modules/
dist/
*.tsbuildinfo
.DS_Store

# never commit real secrets — apps/proxy/.env.example is the template
.env
.env.*
!.env.example

# data/raw holds large downloaded source files; re-download per README rather than committing more
data/raw/.cache/

# build output is generated, but we do want to version data/build/lexicon*.json for now
# (small enough to diff in review; revisit if it grows)

# apps/web/public/lexicon is a copy of data/build/, regenerated by
# `pnpm sync:lexicon` — data/build/ is the versioned source of truth.
apps/web/public/lexicon/

# Same deal for scenarios (`pnpm sync:scenarios`).
apps/web/public/scenarios/

# Same deal for the sentence bank (`pnpm sync:sentences`).
apps/web/public/sentences/

# Playwright/e2e run artifacts — regenerate with `pnpm --filter @anan/web test:e2e`.
apps/web/test-results/
apps/web/playwright-report/
apps/web/screenshots/


# Phase 7: large dictionary dumps live in data/raw/ but are not committed (see data/raw/SOURCES.md).
data/raw/kaikki*
data/raw/Unihan*
data/raw/cedict_*
data/raw/*.zip

# Phase 8: per-profile saved copies written by the proxy at runtime.
apps/proxy/sync-data/

# Phase 10: household audio marks written by the proxy at runtime.
apps/proxy/audio-data/

# Phase 10: copy of data/build/audio (`pnpm sync:audio`).
apps/web/public/audio/

# Phase 12: the textbook is OCAC's — personal study only. PDF and book text stay out of git.
data/raw/textbook/
data/curriculum/*/private/

# Phase 12: copy of data/curriculum/*/book.json + lesson sentences (`pnpm sync:textbook`).
apps/web/public/textbook/
